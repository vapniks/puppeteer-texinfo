@node class Browser
@section class: Browser
@anchor{#class-browser}
@itemize
@item
extends:
@uref{https://nodejs.org/api/events.html#events_class_eventemitter,EventEmitter}
@end itemize

A Browser is created when Puppeteer connects to a Chromium instance,
either through @ref{#puppeteerlaunchoptions,@code{puppeteer.launch}} or
@ref{#puppeteerconnectoptions,@code{puppeteer.connect}}.

An example of using a @ref{#class-browser,Browser} to create a
@ref{#class-page,Page}:

@verbatim
const puppeteer = require('puppeteer');

puppeteer.launch().then(async browser => {
  const page = await browser.newPage();
  await page.goto('https://example.com');
  await browser.close();
});
@end verbatim

An example of disconnecting from and reconnecting to a
@ref{#class-browser,Browser}:

@verbatim
const puppeteer = require('puppeteer');

puppeteer.launch().then(async browser => {
  // Store the endpoint to be able to reconnect to Chromium
  const browserWSEndpoint = browser.wsEndpoint();
  // Disconnect puppeteer from Chromium
  browser.disconnect();

  // Use the endpoint to reestablish a connection
  const browser2 = await puppeteer.connect({browserWSEndpoint});
  // Close Chromium
  await browser2.close();
});
@end verbatim

