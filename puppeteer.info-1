page.waitForResponse(urlOrPredicate[:
#pagewaitforresponseurlorpredicate-options. - *note
page.waitForSelector(selector[: #pagewaitforselectorselector-options. -
*note page.waitForXPath(xpath[: #pagewaitforxpathxpath-options.

     *NOTE* *note ‘page.setDefaultNavigationTimeout’:
     #pagesetdefaultnavigationtimeouttimeout. takes priority over *note
     ‘page.setDefaultTimeout’: #pagesetdefaulttimeouttimeout.


